# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets and local environment
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Large datasets: keep local, never commit raw data
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Generated machine-learning artefacts
models/*
!models/.gitkeep

# Generated reports
reports/generated/*
!reports/.gitkeep

# Databases and logs
*.db
*.sqlite
*.sqlite3
*.log

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
